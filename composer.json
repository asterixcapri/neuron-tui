{
    "name": "asterixcapri/neuron-tui",
    "description": "Reusable terminal user interface for conversations with Neuron AI Agents.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alessandro Astarita",
            "email": "aleast@caprionline.it"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "amphp/amp": "^3.1",
        "amphp/http-client": "^5.3",
        "league/commonmark": "^2.7",
        "neuron-core/neuron-ai": "^3.15.26",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "NeuronTui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronTui\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
