{
    "name": "asterixcapri/neuron-cli",
    "description": "Reusable terminal conversation interface for Neuron AI agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "amphp/amp": "^3.1",
        "amphp/http-client": "^5.3",
        "league/commonmark": "^2.7",
        "neuron-core/neuron-ai": "^3.15.26",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "NeuronCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronCli\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
