{
    "name": "asterixcapri/neuron-tui",
    "description": "Reusable terminal user interface for conversations with Neuron AI Agents.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alessandro Astarita",
            "email": "aleast@caprionline.it"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "amphp/amp": "^3.0",
        "asterixcapri/neuron-interaction": "~0.8.5",
        "league/commonmark": "^2.10",
        "neuron-core/neuron-ai": "^3.0",
        "symfony/tui": "^8.1.2",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "spatie/fork": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "NeuronTui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronTui\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    },
    "config": {
        "sort-packages": true
    }
}
