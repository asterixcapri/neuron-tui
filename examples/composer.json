{
    "name": "asterixcapri/neuron-tui-demo",
    "description": "Demo Host Application for the Neuron TUI.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "amphp/http-client": "^5.3",
        "asterixcapri/neuron-interaction": "~0.9.0@dev",
        "asterixcapri/neuron-tui": "~0.9.0@dev",
        "neuron-core/neuron-ai": "^4.0@dev",
        "symfony/dotenv": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true,
                "versions": {
                    "asterixcapri/neuron-tui": "0.9.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../neuron-interaction",
            "options": {
                "symlink": true,
                "versions": {
                    "asterixcapri/neuron-interaction": "0.9.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "NeuronTuiDemo\\": "src/"
        }
    },
    "scripts": {
        "demo": "php demo.php"
    },
    "config": {
        "sort-packages": true
    }
}
