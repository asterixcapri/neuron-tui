{
    "name": "asterixcapri/neuron-tui-demo",
    "description": "Demo Host Application for the Neuron TUI.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "amphp/http-client": "^5.3",
        "asterixcapri/neuron-interaction": "dev-feat/extract-neuron-interaction",
        "asterixcapri/neuron-tui": "dev-main",
        "neuron-core/neuron-ai": "^3.15.26",
        "symfony/dotenv": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true,
                "versions": {
                    "asterixcapri/neuron-tui": "dev-main"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/asterixcapri/neuron-interaction"
        }
    ],
    "autoload": {
        "psr-4": {
            "NeuronTuiDemo\\": "src/"
        }
    },
    "scripts": {
        "demo": "php demo.php"
    },
    "config": {
        "sort-packages": true
    }
}
