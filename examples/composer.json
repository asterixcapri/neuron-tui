{
    "name": "asterixcapri/neuron-tui-demo",
    "description": "Demo Host Application for the Neuron TUI.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "amphp/http-client": "^5.3",
        "asterixcapri/neuron-tui": "dev-main",
        "neuron-core/neuron-ai": "^3.15.26",
        "symfony/dotenv": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "NeuronTuiDemo\\": "src/"
        }
    },
    "scripts": {
        "demo": "php demo.php"
    },
    "config": {
        "sort-packages": true
    }
}
