{
    "name": "asterixcapri/neuron-tui-example",
    "description": "Basic usage example for Neuron TUI.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "amphp/http-client": "^5.0",
        "asterixcapri/neuron-tui": "1.x-dev",
        "symfony/dotenv": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true,
                "versions": {
                    "asterixcapri/neuron-tui": "1.x-dev"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true
    }
}
